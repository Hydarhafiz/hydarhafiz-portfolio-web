---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { siGit, siGithub, siPydantic } from "simple-icons";
import CaseStudyCard from "../components/CaseStudyCard.astro";
import CredentialList from "../components/CredentialList.astro";
import ExperienceList from "../components/ExperienceList.astro";
import SectionHeading from "../components/SectionHeading.astro";
import SkillExpertise from "../components/SkillExpertise.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import profileImage from "../../docs/career/hydarhafiz-image.jpg";
import careerSource from "../../resume/career-data.json";
import { resolveCareerProfile } from "../../resume/resolve-profile.mjs";

const careerData = resolveCareerProfile(careerSource, "default");

const caseStudies = await getCollection("caseStudies");
const findCaseStudy = (slug: string) => {
  const entry = caseStudies.find((candidate) => candidate.data.slug === slug);
  if (!entry) throw new Error(`Missing approved case study: ${slug}`);
  return entry;
};

const safapac = findCaseStudy("safapac");
const anotherEdenAI = findCaseStudy("anotheredenai");
const airis = findCaseStudy("airis");
const safSkyQuest = findCaseStudy("saf-sky-quest");
const evidenceMetrics = careerSource.portfolioContract.metrics;
---

<SiteLayout
  title="Hydar Hafiz — Backend Engineer | Cloud & Applied AI"
  description="Hydar Hafiz is a software engineer building Python backends, operating AWS cloud delivery, and developing reliability-focused applied AI systems."
>
  <div class="home-page">
    <section class="home-introduction container" aria-labelledby="hero-title">
      <div class="home-introduction__top">
        <div class="home-introduction__copy">
          <p class="eyebrow">Backend Engineer · Cloud &amp; Applied AI</p>
          <h1 id="hero-title">Hi, I'm Hydar</h1>
        </div>
        <figure class="home-introduction__portrait">
          <Image src={profileImage} alt="Portrait of Hydar Hafiz bin Hydzelan" width={400} height={400} loading="eager" />
        </figure>
        <div class="home-introduction__actions">
          <a class="button button--primary" href="#work">View selected work <span aria-hidden="true">↓</span></a>
          <a class="button button--secondary" href="/resume/hydar-hafiz-bin-hydzelan-resume.pdf" download="Hydar_Hafiz_Resume.pdf">Download resume <span aria-hidden="true">↓</span></a>
        </div>
      </div>
      <div class="home-introduction__bottom">
        <div class="home-introduction__role">
          <p class="eyebrow">Engineering focus</p>
          <h2>{careerSource.portfolioContract.identity.hero}</h2>
        </div>
        <p class="home-introduction__summary">{careerData.summary}</p>
        <aside class="home-introduction__aside" aria-label="Availability">
          <p class="home-introduction__aside-label">Current coordinates</p>
          <dl class="metadata-list">
            <div>
              <dt>Based in</dt>
              <dd>{careerData.basics.location}</dd>
            </div>
            <div>
              <dt>Location focus</dt>
              <dd>{careerData.basics.mobility}</dd>
            </div>
            <div>
              <dt>Availability</dt>
              <dd>{careerData.basics.availability}</dd>
            </div>
          </dl>
        </aside>
      </div>
    </section>

    <section id="about" class="home-section home-section--light" aria-labelledby="about-title">
      <div class="container">
        <SectionHeading id="about-title" index="01" title="About me" />
      <div class="about-me">
        <div class="about-me__story">
          <p>I’m a backend engineer based in Bangi, Selangor, with Python, FastAPI, and PostgreSQL as my foundation. I extend that base into Terraform-managed AWS delivery and reliability-focused applied-AI systems.</p>
          <p>At AMIC, I own the backend, database, and AWS delivery scope for SAFAPAC and contribute to AIRIS through AI workload testing, bottleneck analysis, and optimization recommendations for senior review. Outside work, I’m actively developing AnotherEdenAI around typed graph retrieval, deterministic candidate generation, structured validation, and bounded LLM refinement.</p>
          <p>I hold three cloud and AI credentials and am focused on Backend Software Engineer, Cloud &amp; DevOps Engineer, and Applied AI Engineer opportunities in Kuala Lumpur and Selangor from November 2026.</p>
        </div>
        <div class="characteristic-grid" aria-label="Working characteristics">
          <article class="characteristic-card">
            <span class="characteristic-card__logo" aria-hidden="true"><svg viewBox="0 0 24 24" role="img" focusable="false"><path fill="currentColor" d={siGit.path} /></svg></span>
            <span class="characteristic-card__index">01</span>
            <h3>Ownership-minded</h3>
            <p>Takes early-stage backend, data, and cloud scope beyond boilerplate and follows it through delivery.</p>
          </article>
          <article class="characteristic-card">
            <span class="characteristic-card__logo" aria-hidden="true"><svg viewBox="0 0 24 24" role="img" focusable="false"><path fill="currentColor" d={siPydantic.path} /></svg></span>
            <span class="characteristic-card__index">02</span>
            <h3>Traceability-first</h3>
            <p>Strengthens data models, calculation traceability, validation, testing, and operational documentation.</p>
          </article>
          <article class="characteristic-card">
            <span class="characteristic-card__logo" aria-hidden="true"><svg viewBox="0 0 24 24" role="img" focusable="false"><path fill="currentColor" d={siGithub.path} /></svg></span>
            <span class="characteristic-card__index">03</span>
            <h3>Collaborative</h3>
            <p>Works across domain research, frontend delivery, senior engineering, and stakeholder training.</p>
          </article>
        </div>
        </div>
      </div>
    </section>

    <section id="measured-work" class="home-section home-section--dark home-evidence" aria-labelledby="measured-work-title">
      <div class="container">
        <SectionHeading id="measured-work-title" index="02" title="Measured work" />
        <div class="home-evidence__grid">
          {evidenceMetrics.map((metric) => (
            <article class="home-evidence__card">
              <p class="home-evidence__project">{metric.project}</p>
              <h3>{metric.value}</h3>
              <p>{metric.requiredContext.join(" · ")}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="work" class="home-section home-section--light" aria-labelledby="work-title">
      <div class="container">
        <SectionHeading id="work-title" index="03" title="Featured work" />
        <div class="case-grid">
          <CaseStudyCard
            entry={safapac}
            href="/safapac"
            hierarchyLabel="Primary professional case study"
            tone="professional"
            featured
          />
          <CaseStudyCard
            entry={airis}
            href="/airis"
            hierarchyLabel="Major applied-AI case study"
            tone="professional"
            featured
          />
          <CaseStudyCard
            entry={anotherEdenAI}
            href="/anotheredenai"
            hierarchyLabel="Primary personal case study"
            tone="personal"
            externalHref="https://github.com/Hydarhafiz/AnotherEdenAI"
            externalLabel="GitHub"
            featured
          />
          <CaseStudyCard
            entry={safSkyQuest}
            href="/saf-sky-quest"
            hierarchyLabel="Supporting cloud-deployment case study"
            tone="supporting"
          />
        </div>
      </div>
    </section>

    <section id="experience" class="home-section home-section--dark" aria-labelledby="experience-title">
      <div class="container">
        <SectionHeading
          id="experience-title"
          index="04"
          title="Work experience"
        />
        <ExperienceList entries={careerData.experience} />
      </div>
    </section>

    <section id="skills" class="home-section home-section--light" aria-labelledby="skills-title">
      <div class="container">
        <SectionHeading id="skills-title" index="05" title="Skills & expertise" />
        <SkillExpertise groups={careerData.capabilities} />
      </div>
    </section>

    <section id="credentials" class="home-section home-section--dark" aria-labelledby="credentials-title">
      <div class="container">
        <SectionHeading
          id="credentials-title"
          index="06"
          title="Credentials"
        />
        <CredentialList certifications={careerData.certifications} education={careerData.education} />
      </div>
    </section>

    <section id="contact" class="home-section home-section--light home-section--contact" aria-labelledby="contact-title">
      <div class="container">
        <SectionHeading id="contact-title" index="07" title="Get in touch" />
        <nav class="contact-links" aria-label="Public contact links">
          <a class="contact-link" href={`mailto:${careerData.basics.email}`}>
            <span>Email</span>
            <strong>{careerData.basics.email}</strong>
          </a>
          {careerData.basics.links.map((link) => (
            <a
              class="contact-link"
              href={link.url}
              target="_blank"
              rel="noreferrer"
              aria-label={`${link.label}: ${link.display} (opens in new tab)`}
            >
              <span>{link.label}</span>
              <strong>{link.display}</strong>
            </a>
          ))}
          <a class="contact-link" href="/resume">
            <span>Public resume</span>
            <strong>View resume page <span aria-hidden="true">↗</span></strong>
          </a>
        </nav>
      </div>
    </section>
  </div>
</SiteLayout>
