---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="Page not found — Hydar Hafiz" description="The requested page could not be found.">
  <section class="not-found container">
    <p class="eyebrow">404 / Not found</p>
    <h1>This route does not exist.</h1>
    <p class="not-found__description">The page may have moved, or the address may be incomplete.</p>
    <nav class="not-found__actions" aria-label="Recovery links">
      <a class="button button--primary" href="/">Return home</a>
      <a class="button button--secondary" href="/#work">Selected work</a>
      <a class="button button--secondary" href="/resume">Resume</a>
    </nav>
  </section>
</SiteLayout>
