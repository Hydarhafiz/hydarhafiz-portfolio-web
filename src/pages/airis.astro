---
import { getCollection, render } from "astro:content";
import AirisSectionHeading from "../components/AirisSectionHeading.astro";
import CaseStudyPage from "../components/CaseStudyPage.astro";
import SiteLayout from "../layouts/SiteLayout.astro";

const entries = await getCollection("caseStudies");
const entry = entries.find((candidate) => candidate.data.slug === "airis");

if (!entry) {
  throw new Error("Missing approved AIRIS case-study content.");
}

const { Content, headings } = await render(entry);
const adjacent = entries.filter((candidate) => candidate.data.slug !== entry.data.slug);
---

<SiteLayout title="AIRIS — Hydar Hafiz" description={entry.data.summary}>
  <CaseStudyPage entry={entry} headings={headings} adjacent={adjacent}>
    <Content components={{ h2: AirisSectionHeading }} />
  </CaseStudyPage>
</SiteLayout>
