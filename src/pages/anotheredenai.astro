---
import { getCollection, render } from "astro:content";
import CaseStudyPage from "../components/CaseStudyPage.astro";
import SiteLayout from "../layouts/SiteLayout.astro";

const entries = await getCollection("caseStudies");
const entry = entries.find((candidate) => candidate.data.slug === "anotheredenai");

if (!entry) {
  throw new Error("Missing approved AnotherEdenAI case-study content.");
}

const { Content, headings } = await render(entry);
const adjacent = entries.filter((candidate) => candidate.data.slug !== entry.data.slug);
---

<SiteLayout title="AnotherEdenAI — Hydar Hafiz" description={entry.data.summary}>
  <CaseStudyPage
    entry={entry}
    headings={headings}
    adjacent={adjacent}
    repositoryHref="https://github.com/Hydarhafiz/AnotherEdenAI"
  >
    <Content />
  </CaseStudyPage>
</SiteLayout>
