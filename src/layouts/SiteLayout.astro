---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title: string;
  description?: string;
  robots?: string;
}

const {
  title,
  description = "Hydar Hafiz bin Hydzelan — Backend Engineer building production cloud and AI systems.",
  robots = "index, follow"
} = Astro.props;
const currentPath = Astro.url.pathname;
const canonicalPath = currentPath.replace(/\/+$/, "") || "/";
const canonicalUrl = new URL(canonicalPath, Astro.site ?? "https://hydarhafiz.com");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl.toString()} />
    <meta property="og:site_name" content="Hydar Hafiz" />
    <meta property="og:locale" content="en_MY" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:url" content={canonicalUrl.toString()} />
    <link rel="canonical" href={canonicalUrl.toString()} />
    <title>{title}</title>
    <script is:inline>
      (() => {
        try {
          const storedTheme = localStorage.getItem("theme");
          if (storedTheme === "light" || storedTheme === "dark") {
            document.documentElement.dataset.theme = storedTheme;
          }
        } catch {
          // Keep the light-first default when storage is unavailable.
        }
      })();
    </script>
  </head>
  <body>
    <SiteHeader currentPath={currentPath} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
