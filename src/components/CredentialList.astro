---
interface Certification {
  name: string;
  issued: string;
  url: string;
}

interface Education {
  institution: string;
  qualification: string;
  dates: string;
  detail: string;
}

interface Props {
  certifications: Certification[];
  education: Education;
}

const { certifications, education } = Astro.props;

const certificationDetails: Record<string, { mark: string; description: string }> = {
  "AWS Certified Machine Learning Engineer – Associate": {
    mark: "AWS",
    description: "Machine learning engineering on AWS."
  },
  "AWS Certified Cloud Practitioner": {
    mark: "AWS",
    description: "Foundational AWS cloud knowledge."
  },
  "Microsoft Certified: Azure AI Fundamentals": {
    mark: "AZ",
    description: "Foundational AI concepts and Azure services."
  }
};

const credentialId = (url: string) => {
  const segments = url.split("/").filter(Boolean);
  const publicUrlIndex = segments.indexOf("public_url");
  return segments[publicUrlIndex > 0 ? publicUrlIndex - 1 : segments.length - 1] ?? "Public credential";
};
---

<div class="credential-section">
  <section aria-labelledby="certifications-title">
    <h3 id="certifications-title" class="credential-section__title">Certifications</h3>
    <div class="credential-card-grid">
      {certifications.map((certification) => {
        const details = certificationDetails[certification.name] ?? { mark: "CERT", description: "Professional credential." };
        return (
          <article class="credential-card">
            <div class="credential-card__topline">
              <span class="credential-card__logo" aria-hidden="true">{details.mark}</span>
              <span class="credential-card__issued">{certification.issued}</span>
            </div>
            <h4>{certification.name}</h4>
            <p>{details.description}</p>
            <a href={certification.url} target="_blank" rel="noreferrer" aria-label={`${certification.name} verification (opens in new tab)`}>
              <span>Credential ID</span>
              <strong>{credentialId(certification.url)}</strong>
              <span aria-hidden="true">↗</span>
            </a>
          </article>
        );
      })}
    </div>
  </section>

  <section aria-labelledby="education-title">
    <h3 id="education-title" class="credential-section__title">Education</h3>
    <article class="credential-card credential-card--education">
      <div class="credential-card__topline">
        <span class="credential-card__logo" aria-hidden="true">UTP</span>
        <span class="credential-card__issued">{education.dates}</span>
      </div>
      <h4>{education.qualification}</h4>
      <p>{education.institution}</p>
      <p class="credential-card__detail">{education.detail}</p>
    </article>
  </section>
</div>
