---
import ExperienceList from "./ExperienceList.astro";
import CredentialList from "./CredentialList.astro";

interface Basics {
  name: string;
  title: string;
  location: string;
  resumeLocation?: string;
  mobility: string;
  availability: string;
  email: string;
  links: Array<{ label: string; display: string; url: string }>;
}

interface CapabilityGroup {
  category: string;
  items: string[];
}

interface Experience {
  role: string;
  organization: string;
  dates: string;
  bullets: string[];
}

interface Project {
  name: string;
  context: string;
  dates: string;
  url: string;
  bullets: string[];
}

interface Education {
  institution: string;
  qualification: string;
  dates: string;
  detail: string;
}

interface Certification {
  name: string;
  issued: string;
  url: string;
}

interface CareerData {
  basics: Basics;
  summary: string;
  capabilities: CapabilityGroup[];
  experience: Experience[];
  projects: Project[];
  education: Education;
  certifications: Certification[];
}

interface Props {
  data: CareerData;
  publicHeadline: string;
}

const { data, publicHeadline } = Astro.props;
const pdfHref = "/resume/hydar-hafiz-bin-hydzelan-resume.pdf";
const resumeLocation = data.basics.resumeLocation ?? data.basics.location;

const formatRichText = (value: string) => value
  .replaceAll("&", "&amp;")
  .replaceAll("<", "&lt;")
  .replaceAll(">", "&gt;")
  .replaceAll('"', "&quot;")
  .replaceAll(/\*\*(.+?)\*\*/g, "<strong>$1</strong>");
---

<article class="resume-page container">
  <header class="resume-page__header">
    <div class="resume-page__identity">
      <p class="eyebrow">Public resume</p>
      <h1>{data.basics.name}</h1>
      <p class="resume-page__role">{publicHeadline}</p>
    </div>

    <div class="resume-page__actions" aria-label="Resume actions">
      <a class="button button--primary" href={pdfHref} download="Hydar_Hafiz_Resume.pdf">
        Download PDF <span aria-hidden="true">↓</span>
      </a>
      <a class="button button--secondary" href={`mailto:${data.basics.email}`}>
        Email Hydar <span aria-hidden="true">↗</span>
      </a>
    </div>

    <p class="resume-page__meta-line">
      {resumeLocation}<span aria-hidden="true"> · </span>{data.basics.mobility}<span aria-hidden="true"> · </span>{data.basics.availability}
    </p>

    <nav class="resume-page__contact" aria-label="Public resume contact links">
      <a href={`mailto:${data.basics.email}`}>{data.basics.email}</a>
      {data.basics.links.map((link) => (
        <a href={link.url} target="_blank" rel="noreferrer" aria-label={`${link.label}: ${link.display} (opens in new tab)`}>
          {link.label}: {link.display}
        </a>
      ))}
    </nav>
  </header>

  <nav class="resume-page__toc" aria-labelledby="resume-contents-title">
    <p class="resume-page__rail-label">Resume sections</p>
    <h2 id="resume-contents-title">On this page</h2>
    <ol>
      <li><a href="#summary">Summary</a></li>
      <li><a href="#capabilities">Technical Skills</a></li>
      <li><a href="#experience">Professional Experience</a></li>
      <li><a href="#project">Personal Project</a></li>
      <li><a href="#credentials">Education &amp; Certifications</a></li>
    </ol>
  </nav>

  <div class="resume-page__content">
    <section id="summary" class="resume-page__section" aria-labelledby="summary-title">
      <p class="resume-page__section-label">01</p>
      <h2 id="summary-title">Summary</h2>
      <p class="resume-page__summary">{data.summary}</p>
    </section>

    <section id="capabilities" class="resume-page__section" aria-labelledby="capabilities-title">
      <p class="resume-page__section-label">02</p>
      <h2 id="capabilities-title">Technical Skills</h2>
      <dl class="resume-capability-list">
        {data.capabilities.map((group) => (
          <div>
            <dt>{group.category}</dt>
            <dd>{group.items.join(" · ")}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section id="experience" class="resume-page__section" aria-labelledby="experience-title">
      <p class="resume-page__section-label">03</p>
      <h2 id="experience-title">Professional Experience</h2>
      <ExperienceList entries={data.experience} />
    </section>

    <section id="project" class="resume-page__section" aria-labelledby="project-title">
      <p class="resume-page__section-label">04</p>
      <h2 id="project-title">Personal Project</h2>
      {data.projects.map((project) => (
        <article class="resume-project-entry">
          <div class="resume-project-entry__heading">
            <h3>
              <a href={project.url} target="_blank" rel="noreferrer" aria-label={`${project.name} source repository (opens in new tab)`}>
                {project.name} <span aria-hidden="true">↗</span>
              </a>
            </h3>
            <p>{project.dates}</p>
          </div>
          <p class="resume-project-entry__context">{project.context}</p>
          <ul>
            {project.bullets.map((bullet) => <li set:html={formatRichText(bullet)} />)}
          </ul>
        </article>
      ))}
    </section>

    <section id="credentials" class="resume-page__section" aria-labelledby="credentials-title">
      <p class="resume-page__section-label">05</p>
      <h2 id="credentials-title">Education &amp; Certifications</h2>
      <CredentialList certifications={data.certifications} education={data.education} />
    </section>
  </div>
</article>
