---
interface Experience {
  role: string;
  organization: string;
  dates: string;
  bullets: string[];
}

interface Props {
  entries: Experience[];
}

const { entries } = Astro.props;

const formatRichText = (value: string) => value
  .replaceAll("&", "&amp;")
  .replaceAll("<", "&lt;")
  .replaceAll(">", "&gt;")
  .replaceAll('"', "&quot;")
  .replaceAll(/\*\*(.+?)\*\*/g, "<strong>$1</strong>");
---

<div class="experience-list">
  {entries.map((entry) => (
    <article class="experience-entry">
      <div class="experience-entry__heading">
        <div>
          <h3>{entry.role}</h3>
          <p>{entry.organization}</p>
        </div>
        <p class="experience-entry__dates">{entry.dates}</p>
      </div>
      <ul>
        {entry.bullets.map((bullet) => <li set:html={formatRichText(bullet)} />)}
      </ul>
    </article>
  ))}
</div>
