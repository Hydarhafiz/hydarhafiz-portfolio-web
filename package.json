{
  "name": "hydarhafiz-portfolio-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "site:validate": "node scripts/validate-site-foundation.mjs",
    "resume:render": "node scripts/render-resume.mjs --variant public",
    "resume:render:private": "node scripts/render-resume.mjs --variant application",
    "resume:validate": "node scripts/validate-resume.mjs public/resume/hydar-hafiz-bin-hydzelan-resume.pdf --variant public",
    "resume:validate:private": "node scripts/validate-resume.mjs .private/hydar-hafiz-bin-hydzelan-application-resume.pdf --variant application",
    "resume:check": "npm run resume:render && npm run resume:validate",
    "resume:check:all": "npm run resume:render && npm run resume:render:private && npm run resume:validate && npm run resume:validate:private",
    "profile:validate": "node scripts/validate-profile-alignment.mjs",
    "profile:self-test": "node scripts/validate-profile-alignment.mjs --self-test",
    "career:validate": "npm run resume:validate && npm run profile:validate"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@fontsource/source-sans-3": "5.2.8",
    "astro": "^7.2.10",
    "pdfjs-dist": "6.3.289",
    "typescript": "^6.0.3"
  }
}
