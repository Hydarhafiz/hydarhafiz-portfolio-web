{
  "name": "hydarhafiz-portfolio-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "site:validate": "node scripts/validate-site-foundation.mjs",
    "homepage:validate": "node scripts/validate-homepage.mjs",
    "case-studies:validate": "node scripts/validate-case-studies.mjs",
    "visuals:validate": "node scripts/validate-visuals.mjs",
    "resume:render": "node scripts/render-resume.mjs --profile default --contact public",
    "resume:render:backend": "node scripts/render-resume.mjs --profile backend --contact application",
    "resume:render:cloud": "node scripts/render-resume.mjs --profile cloud --contact application",
    "resume:render:ai": "node scripts/render-resume.mjs --profile ai --contact application",
    "resume:render:all": "npm run resume:render && npm run resume:render:backend && npm run resume:render:cloud && npm run resume:render:ai",
    "resume:validate": "node scripts/validate-resume.mjs public/resume/hydar-hafiz-bin-hydzelan-resume.pdf --profile default --contact public",
    "resume:page:validate": "node scripts/validate-resume-page.mjs",
    "resume:validate:backend": "node scripts/validate-resume.mjs .private/Hydar_Hafiz_Resume_Backend.pdf --profile backend --contact application",
    "resume:validate:cloud": "node scripts/validate-resume.mjs .private/Hydar_Hafiz_Resume_Cloud.pdf --profile cloud --contact application",
    "resume:validate:ai": "node scripts/validate-resume.mjs .private/Hydar_Hafiz_Resume_AI.pdf --profile ai --contact application",
    "resume:validate:all": "npm run resume:validate && npm run resume:validate:backend && npm run resume:validate:cloud && npm run resume:validate:ai",
    "resume:check": "npm run resume:render && npm run resume:validate",
    "resume:check:all": "npm run resume:render:all && npm run resume:validate:all",
    "profile:validate": "node scripts/validate-profile-alignment.mjs",
    "profile:self-test": "node scripts/validate-profile-alignment.mjs --self-test",
    "career:validate": "npm run resume:validate && npm run profile:validate"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "^8.0.0",
    "@fontsource/source-sans-3": "5.2.8",
    "astro": "^7.2.10",
    "pdfjs-dist": "6.3.289",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "simple-icons": "^16.29.0"
  }
}
